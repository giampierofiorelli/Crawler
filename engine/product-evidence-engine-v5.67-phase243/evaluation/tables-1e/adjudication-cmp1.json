 "mechanisms": {
  "F-T1": {
   "name": "method statement outside the last paragraph",
   "stage": "context",
   "rule": "R08_unknown_context_no_test_label",
   "generic": "the table reader seeks the test context only in the heading, caption, headers and the last paragraph if it says we/I; a first-person measuring statement elsewhere in the same section is ignored"
  },
  "F-T2": {
   "name": "unit or bare number not resolved from the cell labels",
   "stage": "element",
   "rule": "R12_no_plan_unit",
   "generic": "a bare number takes a label unit only if the whole cell is one bare number without thousands separator; unit-bearing headers like (dBA) or (in nits) and cells with two values (12.9 / 8.9) or 1,251 are not read"
  },
  "F-T3": {
   "name": "dimension word only in the table heading",
   "stage": "element",
   "rule": "R14_no_dimension_term",
   "generic": "the dimension word must be in the cell labels; a heading such as Noise Level Test is ignored"
  },
  "F-T4": {
   "name": "whole cell dropped for a currency",
   "stage": "evidence",
   "rule": "R11_price_in_cell",
   "generic": "a cell 31.3W ($2.74) loses its power value because it also holds a cost"
  },
  "F-T5": {
   "name": "operating-setting axis not carried as condition",
   "stage": "interpretation",
   "rule": "none",
   "generic": "labels such as Speed 2 (Medium) are never attached to the value as its condition"
  },
  "F-T6": {
   "name": "distinct cells collapsed by the duplicate rule",
   "stage": "output",
   "rule": "R16_duplicate",
   "generic": "the lead id hashes the cell text, not its position: two cells with the same text (23 minutes, 48.2 dBA) yield one observation"
  },
  "F-T7": {
   "name": "table cells read as prose by the block reader",
   "stage": "evidence",
   "rule": "plan_guided_measurement_term on td blocks",
   "generic": "the plan-guided block reader reads td text outside the table interpretation: certified CADR and declared spec values become test leads, and table values lose their column product"
  },
  "F-T8": {
   "name": "placeholder corner flips Phase245 orientation",
   "stage": "structure",
   "rule": "phase245 products_in_rows",
   "generic": "a corner cell with placeholder text (Header Cell - Column 0, Row 0 - Cell 0) makes Phase245 read products in rows: production specification facts get the property label as product (not present in the live store)"
  }
 },
